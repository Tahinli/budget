# The systemd user unit budget runs under on the server. The deploy workflow
# installs this file as ~/.config/systemd/user/budget.service on every release,
# reloads the manager, enables the unit and restarts it, so a freshly
# provisioned box needs nothing but the SSH user, the deploy directory and
# `loginctl enable-linger` (once, so the unit outlives the login).
#
# The working directory is the deploy path itself, not the release: the
# binary reads config/budget.toml, the database and the key relative to it,
# and only current/ is swapped by a deploy.
[Unit]
Description=budget
After=network-online.target

[Service]
WorkingDirectory=%h/budget
ExecStart=%h/budget/current/budget-web
Restart=on-failure

[Install]
WantedBy=default.target
